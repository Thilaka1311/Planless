# -----------------------------------------------------------------------------
# Supabase Edge Functions Local Environment Configuration Template
# Copy this file to `supabase/functions/.env` for local Supabase Edge Functions.
# In production, set secrets via Supabase CLI:
#   supabase secrets set TMDB_ACCESS_TOKEN=... TMDB_API_KEY=... GOOGLE_MAPS_API_KEY=...
# -----------------------------------------------------------------------------

# Google Maps API (Used by maps Edge Function for place search & autocomplete)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# The Movie Database (TMDB) Integration
# Required for maps Edge Function handling movies-discover, movies-search, movie-details
TMDB_API_KEY=your-tmdb-api-key
TMDB_ACCESS_TOKEN=your-tmdb-read-access-token
