# -----------------------------------------------------------------------------
# Planless - Environment Configuration Template
# Copy this file to `.env` and fill in the values.
# -----------------------------------------------------------------------------

# Frontend (Vite) Configuration
# -----------------------------------------------------------------------------
# Variables prefixed with VITE_ are exposed to the frontend by Vite.
# Do NOT put secrets in VITE_ variables.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Configuration
PORT=3000
NODE_ENV=development

# Backend-only Secrets
# -----------------------------------------------------------------------------
# These variables are never exposed to the browser.
# -----------------------------------------------------------------------------

# Supabase Admin / Service Details
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Razorpay Integration (Optional in Development)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Resend Mailer API (Optional in Development)
RESEND_API_KEY=your-resend-api-key

# Google Maps API (Used by discovery, places autocomplete, place details)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# The Movie Database (TMDB) Integration
# -----------------------------------------------------------------------------
# Used for movie discovery, search, posters, backdrops, and movie details.
# Required in production as Supabase Edge Function secrets (`supabase secrets set`).
# Required in local development in `.env` / `.env.local` (for Express backend / direct fallback)
# and in `supabase/functions/.env` (for local Supabase Edge Functions).
# Provide either TMDB_ACCESS_TOKEN (v4 Read Access Token) or TMDB_API_KEY (v3 API key).
# -----------------------------------------------------------------------------
TMDB_API_KEY=your-tmdb-api-key
TMDB_ACCESS_TOKEN=your-tmdb-read-access-token
VITE_TMDB_API_KEY=your-tmdb-api-key
VITE_TMDB_ACCESS_TOKEN=your-tmdb-read-access-token

